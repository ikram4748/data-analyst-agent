# Copy this file to .env and paste your key(s). Free keys: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional second key: its free-tier quota is used when the first one is rate-limited.
GEMINI_API_KEY_2=

# Optional settings (defaults shown)
# MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
# REQUESTS_PER_MINUTE=12
# SESSION_QUESTION_LIMIT=0   # >0 caps questions per visitor (public demo)
